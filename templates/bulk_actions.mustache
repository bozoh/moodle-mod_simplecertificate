{{!
    @template mod_simplecertificate/bulk_actions

    Bulk actions with a report builder table

    Each option in the select carries a data-action and data-type attribute
    so the JS module can submit the right action/type pair.

    Example context (json): {
        "actionurl": "view.php",
        "cmid": 123,
        "tab": 2,
        "sesskey": "abc123",
        "reporthtml": "<div>...report builder output...</div>",
        "actionoptions": [
            {"action": "download", "type": "pdf", "label": "Download as PDF"},
            {"action": "download", "type": "zip", "label": "Download as ZIP"}
        ]
    }
}}
<div data-region="bulk-certificates-wrapper"
     data-actionurl="{{actionurl}}"
     data-cmid="{{cmid}}"
     data-tab="{{tab}}"
     data-sesskey="{{sesskey}}">

    {{{reporthtml}}}

    <div class="bulk_controls">
        <label for="bulk-type-select">{{#str}}bulkaction, simplecertificate{{/str}}</label>
        <select id="bulk-type-select" class="form-select custom-select w-auto">
            {{#actionoptions}}
                <option data-action="{{action}}" data-type="{{type}}" {{#noselection}}data-no-selection{{/noselection}} value="{{action}}_{{type}}">{{label}}</option>
            {{/actionoptions}}
        </select>

        <button type="button" class="btn btn-primary" id="bulk-submit-btn" disabled>
            {{#str}}bulkbuttonlabel, simplecertificate{{/str}}
        </button>
    </div>
</div>
